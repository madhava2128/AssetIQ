# AssetIQ Environment Variables Template
# Copy this file to .env and populate with actual credentials

# Database / Storage (PostgreSQL / Supabase)
DATABASE_URL=postgresql://localhost:5432/assetiq
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Application Config & Public URL
NODE_ENV=development
PORT=3000

# Public App Base URL for QR Codes (Section 2)
# MUST be the permanent HTTPS production address (e.g. https://assetiq-omega.vercel.app).
# Set in the Vercel project's Production environment variables.
# Because NEXT_PUBLIC_ values are built into the app at compile time, a new deployment is needed after changing it.
NEXT_PUBLIC_APP_URL=https://assetiq-omega.vercel.app

# Dedicated Test Accounts for scripts/verify-surgery-flow.js
# These test accounts are seeded in the database and clearly marked as test data
TEST_OT_ADMIN_EMAIL=ot.admin@assetiq.in
TEST_OT_ADMIN_PASSWORD=OtPass2026!
TEST_HOSPITAL_ADMIN_EMAIL=admin@assetiq.in
TEST_HOSPITAL_ADMIN_PASSWORD=AdminPass2026!
TEST_BIOMED_ENGINEER_EMAIL=biomed@assetiq.in
TEST_BIOMED_ENGINEER_PASSWORD=BiomedPass2026!

# ML Service URL (Internal binding on Vercel: ML_SERVICE_URL)
ML_SERVICE_URL=http://localhost:8000

# LLM / AI Services
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
